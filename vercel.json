{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "installCommand": "npm install --no-package-lock",
  "rewrites": [
    {
      "source": "/api/tari/:istat",
      "destination": "/api/tari?istat=:istat"
    },
    {
      "source": "/api/cron/scrape",
      "destination": "/api/cron-scrape"
    }
  ]
}
